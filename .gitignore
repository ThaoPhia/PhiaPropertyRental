# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea/*
.idea/workspace.xml
public/images/properties

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local

# local SQLite database
/database/*.db
/database/phia-property-rental.db-shm
/database/phia-property-rental.db-wal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
