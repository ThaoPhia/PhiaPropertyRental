SITE_NAME="Phia Rental LLC"
SITE_PORT=3000
SITE_URL=https://phiapropertyrental.test:${SITE_PORT}

# Local email settings. Docker captures messages in Mailpit; native development
# can use Resend or Mailpit by setting the optional values below.
SITE_EMAIL_TO=admin@example.com
SITE_EMAIL_FROM=admin@example.com
SITE_PHONE_NUMBER="(555) 555-0100"
NEXT_PUBLIC_SITE_EMAIL_TO=${SITE_EMAIL_TO}
NEXT_PUBLIC_SITE_PHONE_NUMBER=${SITE_PHONE_NUMBER}

# SQLite database
SQLITE_DB_PATH=./database/phia-property-rental.db

# Application
NEXT_PUBLIC_API_URL=${SITE_URL}
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=replace-with-a-strong-password
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-google-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-google-recaptcha-secret-key

# Optional: configure Resend for native development email.
# RESEND_API_KEY=your-resend-api-key

# Optional: use Mailpit for native development email.
# MAILPIT_URL=http://localhost:8025

# Optional: trigger a Vercel redeploy after property changes.
# VERCEL_DEPLOY_HOOK_URL=your-vercel-deploy-hook-url

# Optional: enable Supabase Storage for property images and database persistence.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_STORAGE_IMAGE_BUCKET=property-images-public
# SUPABASE_STORAGE_IMAGE_PREFIX=images/properties
# SUPABASE_STORAGE_DB_BUCKET=phia-property-rental-private
# SUPABASE_STORAGE_DB_PULL_ON_BOOT=true
